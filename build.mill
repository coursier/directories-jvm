//| mill-version: 1.4.0-M2
//| mill-jvm-version: temurin:23

package build

import mill.*
import mill.api.BuildCtx
import mill.javalib.*
import mill.javalib.publish.*

import scala.util.Properties

/** Version deduced from the `v*` git tags:
  *   - if HEAD has such a tag, the value after the `v`
  *   - else, the latest such tag, split by '.', keeping only the first 3 elements, with the last one
  *     incremented, and a `-SNAPSHOT` suffix
  */
def computePublishVersion = Task.Input {
  def git(args: String*): Option[String] = {
    val res = os.proc("git", args).call(
      cwd = BuildCtx.workspaceRoot,
      check = false,
      stderr = os.Pipe
    )
    if (res.exitCode == 0) Some(res.out.trim()).filter(_.nonEmpty)
    else None
  }

  val headTag = git("tag", "--points-at", "HEAD", "--list", "v*", "--sort=-v:refname")
    .flatMap(_.linesIterator.map(_.trim).find(_.nonEmpty))

  headTag match {
    case Some(tag) => tag.stripPrefix("v")
    case None =>
      val latest = git("describe", "--tags", "--abbrev=0", "--match", "v*")
        .map(_.stripPrefix("v"))
        .getOrElse("0.0.0")
      val elems   = latest.split('.').take(3).toSeq
      val lastNum = elems.last.takeWhile(_.isDigit).toIntOption.getOrElse(0)
      (elems.init :+ (lastNum + 1).toString).mkString(".") + "-SNAPSHOT"
  }
}

trait DirectoriesPublishModule extends PublishModule {
  def pomSettings = PomSettings(
    description = "directories-jvm",
    organization = "io.get-coursier.util",
    url = "https://github.com/coursier/directories-jvm",
    licenses = Seq(License.`MPL-2.0`),
    versionControl = VersionControl.github("coursier", "directories-jvm"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault")
    )
  )
  def publishVersion = Task {
    computePublishVersion()
  }

  // Maven Central requires a javadoc JAR, but not that it contains anything: publish
  // almost empty ones (just a manifest) rather than running javadoc
  def docJar = Task {
    PathRef(mill.util.Jvm.createJar(Task.dest / "out.jar", Nil))
  }

  def localRepo = Task {
    val dest = Task.dest

    new LocalIvyPublisher(dest).publishLocal(
      pom = pom().path,
      ivy = Right(ivy().path),
      artifact = artifactMetadata(),
      publishInfos = allPublishInfos(sources = true, docs = true)()
    )

    PathRef(dest)
  }
}

object directories extends JavaModule with DirectoriesPublishModule {
  def javacOptions = super.javacOptions() ++ Seq(
    "--release", "8"
  )

  def sources = Task.Sources(BuildCtx.workspaceRoot / "src/main/java")

  def jdk22ClassesResources = Task {
    val destDir = Task.dest / "META-INF/versions/22"
    os.makeDir.all(destDir)
    for (elem <- os.list(jdk22.compile().classes.path))
      os.copy(elem, destDir / elem.last)
    PathRef(Task.dest)
  }

  def resourceDirs = Task.Sources(BuildCtx.workspaceRoot / "src/main/resources")

  def resources = Task {
    resourceDirs() ++ Seq(jdk22ClassesResources())
  }
  def manifest = Task {
    super.manifest().add(
      "Multi-Release" -> "true",
      "Automatic-Module-Name" -> "dev.dirs"
    )
  }
}

object `directories-jni` extends JavaModule with DirectoriesPublishModule {
  def moduleDeps = Seq(directories)
  def mvnDeps = Seq(
    mvn"io.get-coursier.jniutils:windows-jni-utils:0.5.0"
  )
  def javacOptions = super.javacOptions() ++ Seq(
    "--release", "8"
  )
  def manifest = Task {
    super.manifest().add("Automatic-Module-Name" -> "dev.dirs.jni")
  }
}

object jdk22 extends JavaModule {
  def moduleDeps = Seq(directories)
  def javacOptions = super.javacOptions() ++ Seq(
    "--release", "22"
  )
}

/** Test module whose tests can run on JDK 8.
  *
  * Mill's test runner is compiled for Java 11, so it can't run on a JDK 8. When `runsOnJdk8` is
  * true, tests are run with JUnit's own `JUnitCore` runner instead, in a JDK 8 process.
  */
trait Jdk8CompatibleTests extends JavaModule with TestModule {
  def runsOnJdk8: Boolean

  override def testTask(
      args: Task[Seq[String]],
      globSelectors: Task[Seq[String]]
  ): Task[(msg: String, results: Seq[mill.javalib.testrunner.TestResult])] =
    if (runsOnJdk8) junitCoreTestTask(globSelectors)
    else super.testTask(args, globSelectors)

  private def junitCoreTestTask(
      globSelectors: Task[Seq[String]]
  ): Task[(msg: String, results: Seq[mill.javalib.testrunner.TestResult])] = Task.Anon {
    val selectorRegexes = globSelectors().map { glob =>
      glob.split("\\*", -1).map(java.util.regex.Pattern.quote).mkString(".*").r
    }
    val classes = discoveredTestClasses().filter { cls =>
      selectorRegexes.isEmpty || selectorRegexes.exists(_.matches(cls))
    }
    if (classes.isEmpty)
      ("No test classes to run", Nil)
    else {
      val javaExe = javaHome() match {
        case Some(home) =>
          (home.path / "bin" / (if (Properties.isWin) "java.exe" else "java")).toString
        case None => "java"
      }
      val cp = runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
      val res = os.proc(javaExe, forkArgs(), "-cp", cp, "org.junit.runner.JUnitCore", classes)
        .call(
          cwd = forkWorkingDir(),
          env = allForkEnv(),
          stdout = os.Inherit,
          check = false
        )
      if (res.exitCode != 0)
        Task.fail(s"JUnit tests failed (exit code ${res.exitCode})")
      (s"Ran ${classes.length} test class(es) with JUnitCore", Nil)
    }
  }
}

trait Tests extends Cross.Module[String] with JavaModule {
  def jvmId = Task {
    crossValue match {
      // no Temurin 8 builds for macOS arm64
      case "8" => if (Properties.isMac) "zulu:8" else "8"
      case "11" => if (Properties.isMac) "zulu:11" else "11"
      case "22" => "22"
      case _ => super.jvmId()
    }
  }

  def mvnDeps = Seq(
    mvn"${directories.pomSettings().organization}:directories:${directories.publishVersion()}"
  )
  def repositories = Task {
    Seq(
      "ivy:" + directories.localRepo().path.toNIO.toUri.toASCIIString + "[defaultPattern]"
    ) ++ super.repositories()
  }

  object test extends JavaTests with Jdk8CompatibleTests {
    def runsOnJdk8 = crossValue == "8"
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"junit:junit:4.13.2",
      mvn"com.github.sbt:junit-interface:0.13.3"
    )
    def testFramework = "com.novocode.junit.JUnitFramework"
  }
}

trait TestsJni extends Cross.Module[String] with JavaModule {
  def jvmId = Task {
    crossValue match {
      // no Temurin 8 builds for macOS arm64
      case "8" => if (Properties.isMac) "zulu:8" else "8"
      case "11" => if (Properties.isMac) "zulu:11" else "11"
      case _ => super.jvmId()
    }
  }

  def mvnDeps = Seq(
    mvn"${`directories-jni`.pomSettings().organization}:directories-jni:${`directories-jni`.publishVersion()}"
  )
  def repositories = Task {
    Seq(
      "ivy:" + directories.localRepo().path.toNIO.toUri.toASCIIString + "[defaultPattern]",
      "ivy:" + `directories-jni`.localRepo().path.toNIO.toUri.toASCIIString + "[defaultPattern]"
    ) ++ super.repositories()
  }

  object test extends JavaTests with Jdk8CompatibleTests {
    def runsOnJdk8 = crossValue == "8"
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"junit:junit:4.13.2",
      mvn"com.github.sbt:junit-interface:0.13.3"
    )
    def testFramework = "com.novocode.junit.JUnitFramework"
  }
}

// On Windows: 8 and 11 exercise the PowerShell-based implementation, 22 and default (23, the JVM
// Mill runs on) the JDK 22+ foreign function API one, from the multi-release overlay
object tests extends Cross[Tests]("8", "11", "22", "default")

// Windows-specific tests are no-ops on other OSes, but some tests (Java version parsing) run everywhere
object `tests-jni` extends Cross[TestsJni]("8", "11", "default")
